            },
            {
              "id": "c1f0b6a4-3e52-4a8e-8d1b-6f2a9c4d7e12",
              "name": "as_of",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "9a7d2e63-1b4c-4d5f-8e70-3a6b8c0d1e02",
      "name": "Markets",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
