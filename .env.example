# Copy to .env to override defaults. Never commit .env.

# mock = committed synthetic snapshot, no key, no network. live = real RentCast calls.
DATA_MODE=mock
# Only read in live mode. Free developer tier: 50 requests a month.
RENTCAST_API_KEY=
# Hard monthly stop for RentCast requests; set to your plan's included requests.
RENTCAST_MONTHLY_BUDGET=50
# Day of month your RentCast billing period starts (1-28).
RENTCAST_BILLING_ANCHOR_DAY=1
MARKET=dallas
# Model calls (signals and narratives). replay serves recorded responses: no key, no cost.
# record (mock data only) calls the model and writes recordings; live (live data only) calls it.
AGENT_CORE_MODE=replay
# Only read in record and live mode. Use a dedicated key with a spend limit set in the console.
AGENT_CORE_ANTHROPIC_API_KEY=
# Hard stops, in US dollars: per run (all attempts), and per UTC month of billable calls.
LLM_RUN_BUDGET_USD=1.00
LLM_MONTHLY_BUDGET_USD=10.00
# The API's two bearer tokens. Without them every route except /livez answers 401, so set both
# to try anything. Generate: openssl rand -hex 32. Read opens every GET; trigger opens only
# POST /triggers/*. They must differ. Only the api service receives them.
API_READ_TOKEN=
API_TRIGGER_TOKEN=
# Behind a tunnel or proxy, the header that carries the client address (else leave empty).
API_CLIENT_IP_HEADER=
# The proxy addresses (comma-separated IPs or networks) allowed to set that header. Required with it.
API_TRUSTED_PROXIES=
# Delivery of the brief. mock builds and previews the payloads and sends nothing. live sends to a
# Notion test database and a Slack channel with the tokens below (a bot token with chat:write and
# files:write, and an internal integration shared with the database). Only worker and migrate get them.
DELIVERY_MODE=mock
DELIVERY_TARGETS=notion,slack
NOTION_TOKEN=
NOTION_DATABASE_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Where generated media (sample PDFs, screenshots, payload dumps) goes: an absolute path outside
# the repository. Leave empty to write none.
MEDIA_OUT=
# Under Compose, set this to a folder on the host that the container user (uid 10001) can write; it
# is mounted at /media and MEDIA_OUT is set to it for worker and migrate. Mock delivery then leaves
# its PDFs and request lines there.
# MEDIA_OUT_DIR=
# The scheduler (opt-in profile `schedule`): n8n keeps its own encrypted store of credentials. Leave
# the key unset and n8n generates one in its volume, or set one to control it.
# N8N_ENCRYPTION_KEY=
# The database name compose gives the app (change it to run the stack on a scratch database).
FEASIBILITY_DB=feasibility
# Local-only development database password used by docker compose.
POSTGRES_PASSWORD=feasibility-local-dev
# Host tools (tests, CLI) reach the compose database here:
# DATABASE_URL=postgresql+psycopg://feasibility:feasibility-local-dev@127.0.0.1:4502/feasibility
