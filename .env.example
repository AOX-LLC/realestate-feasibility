# Copy to .env to override defaults. Never commit .env.

# mock = committed synthetic snapshot, no key, no network. live = real RentCast calls.
DATA_MODE=mock
# Only read in live mode. Free developer tier: 50 requests a month.
RENTCAST_API_KEY=
# Hard monthly stop for RentCast requests; set to your plan's included requests.
RENTCAST_MONTHLY_BUDGET=50
# Day of month your RentCast billing period starts (1-28).
RENTCAST_BILLING_ANCHOR_DAY=1
MARKET=dallas
# Local-only development database password used by docker compose.
POSTGRES_PASSWORD=feasibility-local-dev
# Host tools (tests, CLI) reach the compose database here:
# DATABASE_URL=postgresql+psycopg://feasibility:feasibility-local-dev@127.0.0.1:4502/feasibility
